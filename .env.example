# Set these in Netlify: Site configuration > Environment variables.
# Variables starting with VITE_ are public (they appear on the website). The others are secret.

# --- Staff sign-in (required) -------------------------------------------
# The owner account. The owner creates every other staff account inside the console.
OWNER_USER_ID=your-user-id
OWNER_PASSWORD=use-a-long-unique-passphrase-of-16-or-more-characters
# A random string of at least 32 characters, used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Only if the owner loses their authenticator phone: set this to any new value (for example today's
# date), redeploy, and the owner sets up two-step sign-in again at the next sign-in. Leave it empty otherwise.
OWNER_2FA_RESET=

# --- Privacy notice (public text; values are visible on the website) -----
VITE_PRIVACY_CONTACT_EMAIL=ai@startuptn.in
VITE_GRIEVANCE_OFFICER=Chairperson, StartupTN
VITE_ORG_ADDRESS=StartupTN Office Space, 10th Floor, Chennai Metro Rail Limited Building, near Nandanam Metro Station, Chennai, Tamil Nadu 600035
# Preserve the currently approved retention period; do not set a new period without confirmation.
VITE_RETENTION_PERIOD=

# --- Optional CAPTCHA: Cloudflare Turnstile (free) -----------------------
# Create a widget at https://dash.cloudflare.com/ > Turnstile, then add both keys.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
